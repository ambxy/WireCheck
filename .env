# Wire Check Environment Configuration

# Decision Engine: jev or rules
DECISION_ENGINE=jev

# TypeSafe Jev API Key and Model
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MODEL=jev-1.13.0
ASI1_API_KEY=dummy_key_to_bypass_validation

# Optional API Keys for Live Data Sources
GLEIF_API_URL=https://api.gleif.org/api/v1
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# Agentverse / uAgents Configuration
AGENT_SEED=wire_check_orchestrator_seed_phrase_here
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_MAILBOX_KEY=your_agentverse_mailbox_api_key_here
